PORT=4000
NODE_ENV=development
MONGODB_URI=mongodb://127.0.0.1:27017/naya-studio
# REQUIRED: min 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=replace-me-with-a-random-string-at-least-32-chars
CLIENT_ORIGIN=http://localhost:3000

# Optional: admin image upload → Cloudinary (Media library + product gallery)
# Easiest: paste the full URL from Cloudinary Dashboard → API Keys → "API environment variable"
# CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
#
# Or set the three values separately:
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Admin bootstrap (npm run set-admin)
# ADMIN_EMAIL=
# ADMIN_PASSWORD=

# Clerk Authentication (Mobile OTP + Email OTP + Google)
# CLERK_SECRET_KEY=
# CLERK_PUBLISHABLE_KEY=

# Store details for invoice generation
# STORE_NAME=Naya Studio
# STORE_ADDRESS=
# STORE_GSTIN=
# STORE_PHONE=
# STORE_EMAIL=

# Email provider: console (default/dev), resend (production)
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_...
# EMAIL_FROM=Naya Story <orders@nayastory.com>

# Upstash Redis (optional — enables production caching layer)
# Create a free database at https://console.upstash.com
# Without this, the app uses in-memory caching (fine for dev and single-instance)
# UPSTASH_REDIS_REST_URL=https://your-db-name.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-token-here

# Razorpay (payment processing — UPI, Cards, Netbanking, Wallets, EMI)
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=...
# RAZORPAY_WEBHOOK_SECRET=...

# --- Scaling & Performance ---

# Cluster mode (multi-process): node dist/cluster.js
# WEB_CONCURRENCY=4

# Order rate limiter (raise during flash sales)
# ORDER_RATE_LIMIT_MAX=50
# ORDER_RATE_LIMIT_WINDOW_MS=900000

# Upload memory limit (bytes). Default: 10MB. Reduce for high-concurrency servers.
# MAX_UPLOAD_BYTES=5242880

# Webhook queue concurrency (parallel webhook handlers)
# WEBHOOK_CONCURRENCY=10

# --- Firebase Phone Authentication ---
# Required for mobile OTP login
# Get from Firebase Console → Project Settings → General
# FIREBASE_PROJECT_ID=your-project-id
# Service account (Firebase Console → Service accounts → Generate new private key)
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
