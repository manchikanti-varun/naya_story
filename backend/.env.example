PORT=4000

# MongoDB — use Atlas in production. Never commit real URIs.
MONGODB_URI=mongodb://127.0.0.1:27017/naya-studio

# Required in production: long random string (e.g. openssl rand -base64 48), min 32 chars. Never use the dev placeholder.
JWT_SECRET=dev-insecure-change-me

# CMS: PATCH /api/content/site saves homepage to draft; POST /api/content/site/publish promotes draft to live storefront.

# Google OAuth (optional)
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=http://localhost:4000/api/auth/google/callback

# Payments (optional)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=whsec_...   # Dashboard → Webhooks → signing secret (POST /api/integrations/webhooks/stripe)
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=...       # Razorpay webhook secret (POST /api/integrations/webhooks/razorpay)

# Storefront origin(s) for CORS — single URL or comma-separated allowlist (production).
CLIENT_ORIGIN=http://localhost:3000
